# Copy to .env and fill in your values. .env is gitignored; never commit it.

# Azure OpenAI. The variable suffix is the selected model config's azure_region
# (conf/model/*.yaml). The default config (gpt5-1-east2) and the cheap model both
# run in EASTUS2, so they share this pair. Point at a different region and the
# suffix changes to match.
AZURE_OPENAI_ENDPOINT_EASTUS2=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY_EASTUS2=<your-azure-openai-key>

# Tavily: web search, and the fetch behind structured_extract.
TAVILY_API_KEY=<your-tavily-key>

# REQUIRED. OpenAlex and NCBI ask callers to identify themselves so they can reach you
# about usage. There is no default: the adapters raise without it. Use an address you
# actually monitor, not a shared one.
CONTACT_EMAIL=<you@your-institution.edu>

# PubMed (NCBI E-utilities) works keyless at 3 req/s; a free API key raises it to
# 10 req/s. Get one at https://account.ncbi.nlm.nih.gov/settings/. Leave blank to skip.
NCBI_API_KEY=

# Optional. Per-call wall-clock deadline in seconds; the code derives one from the
# context size when this is unset.
LLM_CALL_DEADLINE_S=
